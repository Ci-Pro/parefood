{
  "name": "driver",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/driver",
  "targets": {
    "start": {
      "command": "expo start",
      "options": {
        "cwd": "apps/driver"
      }
    },
    "serve": {
      "command": "expo start",
      "options": {
        "cwd": "apps/driver"
      }
    },
    "typecheck": {
      "command": "tsc --noEmit -p tsconfig.json",
      "options": {
        "cwd": "apps/driver"
      }
    },
    "lint": {
      "command": "eslint .",
      "options": {
        "cwd": "apps/driver"
      }
    }
  },
  "tags": ["mobile", "driver"]
}