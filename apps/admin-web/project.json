{
  "name": "admin-web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/admin-web",
  "targets": {
    "dev": {
      "command": "next dev",
      "options": {
        "cwd": "apps/admin-web"
      }
    },
    "build": {
      "command": "next build",
      "options": {
        "cwd": "apps/admin-web"
      }
    },
    "start": {
      "command": "next start",
      "options": {
        "cwd": "apps/admin-web"
      }
    },
    "typecheck": {
      "command": "tsc --noEmit",
      "options": {
        "cwd": "apps/admin-web"
      }
    },
    "lint": {
      "command": "eslint .",
      "options": {
        "cwd": "apps/admin-web"
      }
    }
  },
  "tags": ["web", "admin"]
}